{
  "functions": {
    "api/render-site.js": {
      "maxDuration": 30
    },
    "api/payments-actions.js": {
      "maxDuration": 60
    },
    "api/place-smm-order.js": {
      "maxDuration": 30
    },
    "api/payment-webhook.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/mtp-balance",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/run-scheduled-broadcasts",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'self'; object-src 'none'; form-action 'self' https://accounts.google.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://www.google.com/recaptcha/ https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://upload.wikimedia.org https://www.gstatic.com https://tile.openstreetmap.org https://server.arcgisonline.com https://a.tile.openstreetmap.fr https://b.tile.openstreetmap.fr https://c.tile.openstreetmap.fr https://tile.opentopomap.org https://a.tile.opentopomap.org https://b.tile.opentopomap.org https://c.tile.opentopomap.org https://res.cloudinary.com https://drive.google.com https://*.googleusercontent.com https://tilecache.rainviewer.com https://gibs.earthdata.nasa.gov https://wayback.maptiles.arcgis.com https://s3.amazonaws.com https://clarity.maptiles.arcgis.com; media-src 'self' data: blob: https://res.cloudinary.com https://drive.google.com; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://fcm.googleapis.com https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://firebaseappcheck.googleapis.com https://www.google.com/recaptcha/ https://api.cloudinary.com https://open.er-api.com https://nominatim.openstreetmap.org https://api.open-meteo.com https://air-quality-api.open-meteo.com https://overpass-api.de https://overpass.kumi.systems https://fr.wikipedia.org https://commons.wikimedia.org https://api.rainviewer.com https://s3-us-west-2.amazonaws.com https://s3.amazonaws.com https://tilecache.rainviewer.com https://gibs.earthdata.nasa.gov https://wayback.maptiles.arcgis.com https://server.arcgisonline.com https://clarity.maptiles.arcgis.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; manifest-src 'self'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app.min.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/splash-(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "coeurnohboost.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(sw.js|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/fr/guide",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/fr/guide/:slug",
      "destination": "/guide/:slug",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|__/|[.]well-known/|$|index[.]html$|[^/]+[.](?:js|css|png|jpe?g|webp|svg|ico|woff2?|mp4|webm|json)$).*)",
      "has": [
        {
          "type": "host",
          "value": "coeurnohboost.vercel.app"
        }
      ],
      "destination": "https://coeurnohuniverse.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://coeurnohboost.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://coeurnohboost.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/v2",
      "destination": "/api/place-smm-order?mode=reseller"
    },
    {
      "source": "/api/saspay-webhook",
      "destination": "/api/payment-webhook?provider=saspay"
    },
    {
      "source": "/api/webhooks/saspay",
      "destination": "/api/payment-webhook?provider=saspay"
    },
    {
      "source": "/panel/:slug",
      "destination": "/api/render-site?pstore=:slug"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/render-site?slug=:slug"
    },
    {
      "source": "/s/:slug/manifest.webmanifest",
      "destination": "/api/render-site?slug=:slug&manifest=1"
    },
    {
      "source": "/s/:slug/sw.js",
      "destination": "/api/render-site?slug=:slug&sw=1"
    },
    {
      "source": "/s/:slug/site-icon-192.png",
      "destination": "/api/render-site?slug=:slug&icon=192"
    },
    {
      "source": "/s/:slug/site-icon-512.png",
      "destination": "/api/render-site?slug=:slug&icon=512"
    },
    {
      "source": "/s/:slug/site-icon-180.png",
      "destination": "/api/render-site?slug=:slug&icon=180"
    },
    {
      "source": "/s/:slug/site-icon-maskable.png",
      "destination": "/api/render-site?slug=:slug&icon=maskable"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/render-site?v1=:path*"
    },
    {
      "source": "/s/:slug/sitemap.xml",
      "destination": "/api/render-site?slug=:slug&sitemap=site"
    },
    {
      "source": "/s/:slug/produit/:p",
      "destination": "/api/render-site?slug=:slug&detail=produit&item=:p"
    },
    {
      "source": "/s/:slug/service/:p",
      "destination": "/api/render-site?slug=:slug&detail=service&item=:p"
    },
    {
      "source": "/s/:slug/article/:p",
      "destination": "/api/render-site?slug=:slug&detail=article&item=:p"
    },
    {
      "source": "/p/:kind/:id",
      "destination": "/api/render-site?share=:kind&id=:id"
    },
    {
      "source": "/e/:id",
      "destination": "/api/render-site?biz=:id"
    },
    {
      "source": "/sitemap-sites.xml",
      "destination": "/api/render-site?sitemap=1"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/render-site?sitemap=pages"
    },
    {
      "source": "/services",
      "destination": "/api/render-site?landing=index"
    },
    {
      "source": "/services/:slug",
      "destination": "/api/render-site?landing=:slug"
    },
    {
      "source": "/aide",
      "destination": "/api/render-site?landing=aide"
    },
    {
      "source": "/guide",
      "destination": "/api/render-site?guide=hub&glang=fr"
    },
    {
      "source": "/guide/:slug",
      "destination": "/api/render-site?guide=:slug&glang=fr"
    },
    {
      "source": "/:glang(en|es|it|pt)/guide",
      "destination": "/api/render-site?guide=hub&glang=:glang"
    },
    {
      "source": "/:glang(en|es|it|pt)/guide/:slug",
      "destination": "/api/render-site?guide=:slug&glang=:glang"
    },
    {
      "source": "/about",
      "destination": "/legal.html?p=about"
    },
    {
      "source": "/terms",
      "destination": "/legal.html?p=terms"
    },
    {
      "source": "/privacy",
      "destination": "/legal.html?p=privacy"
    },
    {
      "source": "/refund",
      "destination": "/legal.html?p=refund"
    },
    {
      "source": "/contact",
      "destination": "/legal.html?p=contact"
    }
  ]
}
